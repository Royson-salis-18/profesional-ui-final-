# api-gateway. Edge routing + JSON access log in the exact shape the mapper's Tier-1 parser reads
# (upstream_addr is how a request is attributed to the backend that served it).
worker_processes auto;
events { worker_connections 4096; }
http {
  log_format mapper escape=json
    '{"timestamp":"$time_iso8601","method":"$request_method","uri":"$uri","request":"$request",'
    '"status":"$status","body_bytes_sent":"$body_bytes_sent","request_time":"$request_time",'
    '"upstream_addr":"$upstream_addr","upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time"}';
  access_log /dev/stdout mapper;
  error_log  /dev/stderr warn;

  # Docker's embedded DNS. Using variables in proxy_pass defers resolution to request time, so the
  # gateway boots (and stays up) even while a backend is down -- required for realistic failures.
  resolver 127.0.0.11 valid=5s ipv6=off;

  proxy_connect_timeout 2s;
  proxy_read_timeout    ${GATEWAY_READ_TIMEOUT};
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header X-Request-Id $request_id;

  server {
    listen 8080;
    location = /healthz { return 200 'ok'; }

    location /api/catalog/ { set $up http://catalog:3001;  rewrite ^/api/catalog/(.*)$ /$1 break; proxy_pass $up; }
    location /api/cart/    { set $up http://cart:3002;     rewrite ^/api/cart/(.*)$ /carts/$1 break;  proxy_pass $up; }
    location /api/orders   { set $up http://orders:3005;   rewrite ^/api/orders(.*)$ /orders$1 break; proxy_pass $up; }
    location /api/checkout { set $up http://orders:3005;   rewrite ^/api/checkout$ /checkout break;   proxy_pass $up; }
  }
}
