  {
   "type": "timeseries",
   "title": "Error log lines / s by service",
   "id": 24,
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 58
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
