# edge: public entry point + JSON access log in the shape the mapper's Tier-1 parser reads.
worker_processes auto;
events { worker_connections 4096; }
http {
  log_format mapper escape=json
    '{"timestamp":"$time_iso8601","method":"$request_method","uri":"$uri","request":"$request",'
    '"status":"$status","body_bytes_sent":"$body_bytes_sent","request_time":"$request_time",'
    '"upstream_addr":"$upstream_addr","upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time"}';
  access_log /dev/stdout mapper;
  error_log  /dev/stderr warn;
  resolver 127.0.0.11 valid=5s ipv6=off;
  proxy_connect_timeout 2s;
  proxy_read_timeout    ${EDGE_READ_TIMEOUT};
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Idempotency-Key $http_idempotency_key;

  server {
    listen 8081;
    location = /healthz { return 200 'ok'; }
    location /api/accounts/   { set $up http://accounts:3101;           rewrite ^/api/accounts/(.*)$ /accounts/$1 break;     proxy_pass $up; }
    location /api/transfers   { set $up http://transfers:3102;          rewrite ^/api/transfers$ /transfers break;           proxy_pass $up; }
    location /api/statements/ { set $up http://statements-worker:3106;  rewrite ^/api/statements/(.*)$ /statements/$1 break; proxy_pass $up; }
  }
}
